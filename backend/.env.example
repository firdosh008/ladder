# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# NOTE: no JWT secret needed — we verify user tokens via Supabase's JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) using the asymmetric ES256 key.

# CORS — comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider defaults (optional at this stage — fill in as agents come online)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Scene hero images — OpenAI Images API (`images.generate`).
# Model defaults to dall-e-3 in code if unset. Quality defaults to hd (dall-e-3).
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_QUALITY=hd
# OPENAI_IMAGE_SIZE=1024x1024
# For GPT Image models try: OPENAI_IMAGE_MODEL=gpt-image-2 plus OPENAI_IMAGE_QUALITY=high
# SCENE_AI_IMAGE_COUNT=3
# SCENE_IMAGE_GEN_ENABLED=true
# frame_anchor (default) = thumbnail inside each outline frame; canvas_bottom_strip = legacy bottom row
# SCENE_IMAGE_PLACEMENT=frame_anchor
# Max JSON body size for POST .../scene/share (bytes). Default 15 MiB in code.
# SCENE_PUBLISH_MAX_ENVELOPE_BYTES=15728640
# Optional comma-separated HTTPS URLs (PNG/JPEG/WebP) fetched server-side after AI:
# SCENE_REMOTE_IMAGE_URLS=https://example.com/a.png,https://example.com/b.jpg

GOOGLE_API_KEY=
EXA_API_KEY=

# Override the default Anthropic model used by CrewAI agents
# ANTHROPIC_MODEL=claude-haiku-4-5
